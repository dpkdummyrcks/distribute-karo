DK_APP_PASSWORD=change-me
POSTGRES_HOST_PORT=55432

VALKEY_PASSWORD=change-me
VALKEY_HOST_PORT=56379

# 64 hex chars
GARAGE_RPC_SECRET=change-me
GARAGE_ADMIN_TOKEN=change-me
